# AgenticCTI Configuration
# Copy this file to .env and fill in your values

# LLM Configuration
LLM_PROVIDER=ollama  # Options: ollama, openai, anthropic

# Recommended CTI-optimized model (see docs/RECOMMENDED_MODELS.md)
LLM_MODEL=ALIENTELLIGENCE/cybersecuritythreatanalysisv2  # Best for CTI analysis
# Alternative models:
# LLM_MODEL=llama3.2:latest  # General purpose
# LLM_MODEL=qwen2.5-coder:14b-q4_K_M  # For malware/code analysis
# LLM_MODEL=gpt-oss:20b-q4_K_M  # For deep investigations

LLM_BASE_URL=http://localhost:11434  # Ollama URL (if using ollama)
OPENAI_API_KEY=  # OpenAI API key (if using openai)
ANTHROPIC_API_KEY=  # Anthropic API key (if using anthropic)
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192  # Increased for CTI models with larger context

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@example.com
EMAIL_TO=recipient@example.com
EMAIL_DAILY_TIME=07:00  # Time to send daily report (HH:MM)
EMAIL_TIMEZONE=America/Montreal

# STIX Export Configuration
ENABLE_STIX_EXPORT=true
STIX_EXPORT_PATH=./data/stix_exports

# Trend Vision One Configuration
TREND_VISION_ONE_ENABLED=false
TREND_VISION_ONE_API_KEY=
TREND_VISION_ONE_BASE_URL=https://api.xdr.trendmicro.com
TREND_VISION_ONE_REGION=us  # Options: us, eu, au, sg, in, jp

# VirusTotal Configuration (Optional)
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_RATE_LIMIT=15.0  # Seconds between requests (free tier: 4 req/min = 15s delay)

# SpiderFoot Configuration (Optional)
SPIDERFOOT_ENABLED=false
SPIDERFOOT_URL=http://localhost:5001
SPIDERFOOT_API_KEY=  # Optional API key for authentication

# OpenCTI Configuration
OPENCTI_ENABLED=false
OPENCTI_URL=http://localhost:8080
OPENCTI_API_KEY=
OPENCTI_SSL_VERIFY=true

# NG-TIP Platform Integration
NGTIP_ENABLED=true  # Enable integration with NG-TIP platform
NGTIP_URL=http://localhost:8503  # NG-TIP API URL
NGTIP_API_KEY=  # Optional API key for authentication
NGTIP_SSL_VERIFY=false  # Verify SSL certificates

# Neo4j Configuration (for NG-TIP Graph Features - Optional)
NGTIP_NEO4J_ENABLED=true  # Enable graph relationship features (requires Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password  # Change this!
# Note: Set NGTIP_NEO4J_ENABLED=false to disable graph features and skip Neo4j deployment

# Streamlit UI Configuration
STREAMLIT_PORT=8501
STREAMLIT_AUTH_ENABLED=true
STREAMLIT_USERNAME=admin
STREAMLIT_PASSWORD=changeme  # Change this!

# Agent Configuration
AGENT_RUN_INTERVAL=86400  # Run interval in seconds (86400 = 24 hours)
AGENT_MAX_SOURCES=20  # Maximum CTI sources to discover
AGENT_MAX_ARTICLES_PER_SOURCE=10  # Max articles per source
CTI_SOURCES_FILE=./config/cti_sources.yaml

# Crawl4ai Configuration (Advanced Web Scraping)
CRAWL4AI_BASE_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=  # Optional API token
USE_CRAWL4AI=false  # Enable Crawl4ai for main agent (requires docker-compose)

# REST API Configuration
API_PORT=8000
API_HOST=0.0.0.0
API_RATE_LIMIT=100  # Requests per period
API_RATE_LIMIT_PERIOD=60  # Period in seconds

# Logging Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/agentic_cti.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Database Configuration (SQLite for simplicity)
DATABASE_PATH=./data/agentic_cti.db

# Proxy Configuration (optional)
HTTP_PROXY=
HTTPS_PROXY=

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
