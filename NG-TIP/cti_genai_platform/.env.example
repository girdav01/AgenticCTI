# CTI GenAI Platform Configuration Template
# Copy this file to .env and fill in your values

# ==============================================================================
# LLM Configuration
# ==============================================================================

# Provider: ollama, lmstudio, openai, anthropic, azure
LLM_PROVIDER=ollama

# Model name (depends on provider)
# Ollama: llama3.2, mistral, codellama, etc.
# LM Studio: local-model
# OpenAI: gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229
LLM_MODEL=llama3.2

# Base URL for local LLMs
# Ollama default: http://localhost:11434
# LM Studio default: http://localhost:1234/v1
LLM_BASE_URL=http://localhost:11434

# API Key (required for cloud providers)
LLM_API_KEY=

# ==============================================================================
# MISP Configuration
# ==============================================================================

# MISP instance URL
MISP_URL=https://misp.local

# MISP API key
MISP_API_KEY=

# Verify SSL certificates
MISP_VERIFY_SSL=True

# ==============================================================================
# OpenCTI Configuration
# ==============================================================================

# OpenCTI instance URL
OPENCTI_URL=http://localhost:8080

# OpenCTI API token
OPENCTI_TOKEN=

# ==============================================================================
# Neo4j Graph Database Configuration
# ==============================================================================

# Neo4j connection URI
NEO4J_URI=bolt://localhost:7687

# Neo4j username
NEO4J_USER=neo4j

# Neo4j password
NEO4J_PASSWORD=password

# ==============================================================================
# Vector Store Configuration
# ==============================================================================

# Vector store type: chroma, faiss, qdrant
VECTOR_STORE_TYPE=chroma

# Path for vector store data
VECTOR_STORE_PATH=./data/vector_store

# ==============================================================================
# Embedding Model Configuration
# ==============================================================================

# Sentence transformer model for embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==============================================================================
# Application Settings
# ==============================================================================

# Debug mode
DEBUG_MODE=False

# Data directory
DATA_DIR=./data

# Cache directory
CACHE_DIR=./cache

# Logs directory
LOGS_DIR=./logs
